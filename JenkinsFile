
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building Python application'
                sh 'python3 --version'
                sh 'python3 -m py_compile app.py test_app.py'
            }
        }

        stage('Test') {
            steps {
                echo 'Running automated Python tests'
                sh 'python3 -m unittest -v test_app'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image'
                sh 'docker build -t python-app:latest .'
            }
        }

        stage('Docker Test') {
            steps {
                echo 'Running unit tests inside Docker'
                sh 'docker run --rm python-app:latest python3 -m unittest -v test_app'

                echo 'Running Python application inside Docker'
                sh 'docker run --rm python-app:latest'
            }
        }
    }
        stage('Deploy') {
            steps {
                echo 'Deploying Python application'
                sh 'docker rm -f python-app || true'
                sh 'docker run -d --name python-app python-app:latest tail -f /dev/null'
                sh 'docker exec python-app python3 app.py'
            }
        }

    post {
        success {
            echo 'SUCCESS: CI pipeline completed!'
        }

        failure {
            echo 'FAILURE: Check the Console Output for errors.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
